# PostgreSQL connection string; use your own database credentials.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Required: a unique, cryptographically random secret of at least 32 characters.
# Generate locally with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET="REPLACE_WITH_RANDOM_SECRET"

# Canonical origin; HTTPS is required in production.
BETTER_AUTH_URL="http://localhost:3000"

# Only needed when explicitly running the seed. Never reuse a real password here.
SEED_ADMIN_PASSWORD="REPLACE_WITH_UNIQUE_SEED_PASSWORD"
